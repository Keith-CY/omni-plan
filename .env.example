# Generate at least 32 random bytes for each administrative secret.
OMNIPLAN_API_ADMIN_TOKEN=
OMNIPLAN_CRON_TOKEN=
OMNIPLAN_DB_PATH=.data/omni-plan.sqlite
OMNIPLAN_REQUIRE_HTTPS=1
PORT=8787

# `bun server/cli.ts vapid generate`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Public browser transport config. These are served by /api/client-config so a
# new device only needs the workspace passphrase. Do not put the passphrase or
# Owner Token here.
OMNIPLAN_FIREBASE_PROJECT_ID=
OMNIPLAN_FIREBASE_WEB_API_KEY=
OMNIPLAN_FIREBASE_DATABASE_ID=(default)
OMNIPLAN_FIREBASE_COLLECTION_PATH=omniPlanSync
OMNIPLAN_FIREBASE_WORKSPACE_ID=personal
