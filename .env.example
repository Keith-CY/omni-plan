# Generate at least 32 random bytes for each administrative secret.
OMNIPLAN_API_ADMIN_TOKEN=
OMNIPLAN_CRON_TOKEN=
OMNIPLAN_DB_PATH=.data/omni-plan.sqlite
OMNIPLAN_REQUIRE_HTTPS=1
PORT=8787

# `bun server/cli.ts vapid generate`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
